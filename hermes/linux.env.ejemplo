# Copia estas lineas a ~/.hermes/.env en el PORTATIL Linux.
# API_SERVER_KEY tiene que ser EXACTAMENTE la HERMES_KEY del .env de JARVIS en Windows.

API_SERVER_ENABLED=true
API_SERVER_HOST=0.0.0.0
API_SERVER_PORT=8642
API_SERVER_KEY=

# Telegram va en Linux (un solo bot). No lo pongas tambien en Windows.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_ALLOWED_USERS=
# HERMES_TELEGRAM_DISABLE_FALLBACK_IPS=true

# Misma clave OpenRouter que JARVIS
# OPENROUTER_API_KEY=
