# ============================================================
#  J.A.R.V.I.S. — configuración
#
#  No hace falta tocar este archivo a mano: se rellena desde
#  la propia aplicación, en AJUSTES → CLAVES Y SERVICIOS.
# ============================================================

# ---------- Cerebro (obligatorio para el chat) ----------
# Consigue una clave gratis en https://openrouter.ai/keys
# La misma clave sirve para el chat y para la visión.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://openrouter.ai/api/v1
DEEPSEEK_MODEL=deepseek/deepseek-v4-flash

# ---------- Hermes (agente en OTRO PC de la Wi-Fi; el LLM sigue siendo OpenRouter) ----------
# El HUD de Windows es localhost (127.0.0.1:8080). Hermes NO: tiene que
# escuchar en 0.0.0.0:8642 en el Linux para que este PC lo alcance.
# Cambia 192.168.1.100 por la IPv4 REAL del Linux (hostname -I).
# HERMES_KEY = API_SERVER_KEY de ~/.hermes/.env (el mismo secreto).
# Guía: README → «Configurar Hermes en red».
HERMES_ENABLED=1
HERMES_URL=http://192.168.1.100:8642/v1
HERMES_KEY=
HERMES_MODEL=hermes-agent
# 0 = si Hermes esta caido, avisa. 1 = usa OpenRouter directo (Ajustes).
HERMES_FALLBACK=0
# auto = charla aquí, acciones en el portátil. hermes o deepseek = forzado.
CEREBRO=auto
# 1 = briefing al abrir (hora, tiempo, Hermes). 0 = saludo corto.
JARVIS_BRIEFING=1

# Token del bot de Telegram: en ~/.hermes/.env del LINUX, no aqui.

# Precios del modelo (USD por millón de tokens) para el contador de gasto
PRICE_INPUT=0.064
PRICE_OUTPUT=0.129
PRICE_CACHE=0.0028

# ---------- Visión (opcional: la cámara describe lo que ve) ----------
# Misma clave de OpenRouter que arriba
OPENROUTER_API_KEY=
JARVIS_VISION_MODEL=google/gemma-4-31b-it:free

# ---------- Voz (Fish Audio) ----------
# Clave: https://fish.audio/app/developers
# Voces: https://fish.audio/discovery  (id en FISH_VOICE_ID)
FISH_API_KEY=
FISH_VOICE_ID=
FISH_VOLUME=0
FISH_EMOTION=calm
FISH_MODEL=s2.1-pro-free
# Cómo habla (independiente de la voz): jarvis, fermin, kratos, tobey, amador, saul, sergio
PERSONALIDAD=jarvis

# Reserva si Fish no responde (edge-tts, internet)
JARVIS_FALLBACK_VOICE=es-ES-AlvaroNeural
JARVIS_VOICE_CHAT_WHOLE=0
# Oído: small oye mejor que base. Primera vez descarga el modelo.
JARVIS_WHISPER_MODEL=large-v3-turbo
JARVIS_WHISPER_BEAM=3

# ---------- El tiempo ----------
# Coordenadas de tu ciudad (ejemplo: Madrid). Cambia las tuyas.
JARVIS_LAT=40.4168
JARVIS_LON=-3.7038

# ---------- Spotify (opcional) ----------
# App en https://developer.spotify.com/dashboard
# Redirect URI exacta: http://127.0.0.1:8080/api/spotify/callback
SPOTIFY_CLIENT_ID=
JARVIS_AUTH_FILE=auth.json

# ---------- Tuya / Smart Life (luces, tele, aire) ----------
# IoT Platform: https://iot.tuya.com  → Cloud → Project → Access ID / Secret
# Región eu si la app es Europa. Device ID = el de cualquier aparato vinculado.
TUYA_ACCESS_ID=
TUYA_ACCESS_SECRET=
TUYA_REGION=eu
TUYA_DEVICE_ID=
# Opcional: ip+key locales en tuya.json (más rápido que la nube).
