{
  "name": "jarvis",
  "productName": "J.A.R.V.I.S.",
  "version": "1.0.0",
  "description": "Asistente personal J.A.R.V.I.S.",
  "main": "main.js",
  "author": "Poxi",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable nsis"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.poxi.jarvis",
    "productName": "J.A.R.V.I.S.",
    "directories": {
      "output": "../dist-electron",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "cargando.html",
      "tutorial.html",
      "tutorial.js",
      "build/icon.ico"
    ],
    "extraResources": [
      {
        "from": "../app",
        "to": "app-python/app",
        "filter": [
          "**/*",
          "!**/__pycache__/**",
          "!**/*.pyc",
          "!**/.env",
          "!**/tuya.json",
          "!**/auth.json"
        ]
      },
      {
        "from": "../memoria",
        "to": "app-python/memoria",
        "filter": [
          "**/*.md",
          "!avisos.json"
        ]
      },
      {
        "from": "env.plantilla",
        "to": "app-python/.env"
      },
      {
        "from": "../requirements.txt",
        "to": "app-python/requirements.txt"
      },
      {
        "from": "../personalidades",
        "to": "app-python/personalidades",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "executableName": "J.A.R.V.I.S.",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "J.A.R.V.I.S.",
      "artifactName": "JARVIS-Setup-${version}.${ext}",
      "include": "build/installer.nsh"
    },
    "portable": {
      "artifactName": "JARVIS-Portable-${version}.${ext}"
    }
  },
  "allowScripts": {
    "electron@33.4.11": true
  }
}
